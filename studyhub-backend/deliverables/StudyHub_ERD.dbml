Table User {
  UserID int [pk, increment]
  FullName varchar(100) [not null]
  Email varchar(150) [unique, not null]
  PasswordHash varchar(255) [not null]
  Role varchar(10) [not null, note: 'Teacher or Student']
}

Table Subject {
  SubjectID int [pk, increment]
  SubjectCode varchar(20) [unique, not null]
  SubjectName varchar(100) [not null]
}

Table Category {
  CategoryID int [pk, increment]
  CategoryName varchar(50) [unique, not null]
}

Table LearningMaterial {
  MaterialID int [pk, increment]
  Title varchar(150) [not null]
  Description text
  FilePath varchar(255) [not null]
  UploadDate datetime [not null, default: `CURRENT_TIMESTAMP`]
  UserID int [not null, ref: > User.UserID]
  SubjectID int [not null, ref: > Subject.SubjectID]
  CategoryID int [not null, ref: > Category.CategoryID]
}

Table Download {
  DownloadID int [pk, increment]
  UserID int [not null, ref: > User.UserID]
  MaterialID int [not null, ref: > LearningMaterial.MaterialID]
  DownloadDate datetime [not null, default: `CURRENT_TIMESTAMP`]
}
