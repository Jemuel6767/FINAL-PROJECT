{
  "info": {
    "name": "StudyHub Backend API",
    "description": "StudyHub API requests. Import StudyHub_Postman_Environment.postman_environment.json and select the StudyHub Local environment before sending requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Register Student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Student\",\n  \"email\": \"{{student_email}}\",\n  \"password\": \"Student123!\"\n}"
        },
        "url": "{{base_url}}/auth/register"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('student_email', `postman.student.${Date.now()}@example.com`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Registration returns 201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('Registration returns an access token', () => pm.expect(body.access_token).to.be.a('string').and.not.empty);",
              "if (body.access_token) pm.environment.set('student_token', body.access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login",
