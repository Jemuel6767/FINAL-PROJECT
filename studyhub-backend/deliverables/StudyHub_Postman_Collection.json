             },
    "item":  [
                 {
                     "name":  "Authentication",
                     "description":  "Login, student registration, and logout.",
                     "item":  [
                                  {
                                      "name":  "REGISTER STUDENT",
                                      "request":  {
                                                      "method":  "POST",
                                                      "header":  {
                                                                     "key":  "Content-Type",
                                                                     "value":  "application/json"
                                                                 },
                                                      "body":  {
                                                                   "raw":  "{\n  \"fullName\": \"Demo Student\",\n  \"email\": \"{{student_email}}\",\n  \"password\": \"{{student_password}}\"\n}",
                                                                   "options":  {
                                                                                   "raw":  {
                                                                                               "language":  "json"
                                                                                           }
                                                                               },
                                                                   "mode":  "raw"
                                                               },
                                                      "url":  "{{base_url}}/auth/register"
                                                  },
                                      "description":  "Create a Student account; this endpoint cannot create a Teacher."
                                  },
                                  {
                                      "name":  "LOGIN TEACHER",
                                      "request":  {
                                                      "method":  "POST",
                                                      "header":  {
                                                                     "key":  "Content-Type",
                                                                     "value":  "application/json"
                                                                 },
                                                      "body":  {
                                                                   "raw":  "{\n  \"email\": \"{{teacher_email}}\",\n  \"password\": \"{{teacher_password}}\"\n}",
                                                                   "options":  {
                                                                                   "raw":  {
                                                                                               "language":  "json"
                                                                                           }
                                                                               },
                                                                   "mode":  "raw"
                                                               },
                                                      "url":  "{{base_url}}/auth/login"
                                                  },
                                      "description":  "Use the seeded teacher credentials. Copy access_token and user.userId from the response into the environment."
                                  },
                                  {
                                      "name":  "LOGIN STUDENT",
                                      "request":  {
                                                      "method":  "POST",
                                                      "header":  {
                                                                     "key":  "Content-Type",
                                                                     "value":  "application/json"
                                                                 },
                                                      "body":  {
                                                                   "raw":  "{\n  \"email\": \"{{student_email}}\",\n  \"password\": \"{{student_password}}\"\n}",
                                                                   "options":  {
                                                                                   "raw":  {
                                                                                               "language":  "json"
                                                                                           }
                                                                               },
                                                                   "mode":  "raw"
                                                               },
                                                      "url":  "{{base_url}}/auth/login"
                                                  },
                                      "description":  "Copy access_token and user.userId from the response into the environment."
                                  },
                                  {
                                      "name":  "LOGOUT",
                                      "request":  {
                                                      "method":  "POST",
                                                      "header":  [

                                                                 ],
                                                      "auth":  {
                                                                   "bearer":  [
                                                                                  {
                                                                                      "key":  "token",
                                                                                      "type":  "string",
                                                                                      "value":  "{{access_token}}"
                                                                                  }
                                                                              ],
                                                                   "type":  "bearer"
                                                               },
                                                      "url":  "{{base_url}}/auth/logout"
                                                  },
                                      "description":  "Revokes the bearer token in the environment."
                                  }
                              ]
                 },
