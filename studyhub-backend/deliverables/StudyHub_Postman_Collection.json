    },
    {
      "name": "Create Material (Teacher)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{teacher_token}}"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "title",
              "value": "Lecture Notes",
              "type": "text"
            },
            {
              "key": "description",
              "value": "Sample notes",
              "type": "text"
            },
            {
              "key": "subjectId",
              "value": "{{subject_id}}",
              "type": "text"
            },
            {
              "key": "categoryId",
              "value": "{{category_id}}",
              "type": "text"
            },
            {
              "key": "file",
              "type": "file",
              "src": ""
            }
          ]
        },
        "url": "{{base_url}}/materials"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Material is created (201)', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
