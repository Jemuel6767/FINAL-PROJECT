    {
      "name": "Create Material (Teacher)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{teacher_token}}"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "title",
              "value": "Postman Material {{subject_id}}",
              "type": "text"
            },
            {
              "key": "description",
              "value": "Sample notes",
              "type": "text"
            },
            {
              "key": "subjectId",
              "value": "{{subject_id}}",
              "type": "text"
            },
            {
              "key": "categoryId",
              "value": "{{category_id}}",
              "type": "text"
            },
            {
              "key": "file",
              "type": "file",
              "src": ""
            }
          ]
        },
        "url": "{{base_url}}/materials"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.environment.get('teacher_token')) { console.warn(\"Create Material (Teacher) skipped: first run Login Teacher (Demo) with a seeded teacher account.\"); pm.execution.skipRequest(); }",
              "if (pm.environment.get('material_file_ready') !== 'true') { console.warn(\"Create Material skipped: attach a PDF/DOCX/PPTX/TXT file and set material_file_ready=true in the StudyHub Local environment.\"); pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Material is created (201)', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('Created material has an ID', () => pm.expect(body.id).to.exist);",
              "if (body.id) pm.environment.set('material_id', String(body.id));"
            ]
          }
        }
      ]
