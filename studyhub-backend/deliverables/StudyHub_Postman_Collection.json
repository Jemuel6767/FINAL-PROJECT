    {
      "name": "Login Teacher (Demo)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{teacher_email}}\",\n  \"password\": \"{{teacher_password}}\"\n}"
        },
        "url": "{{base_url}}/auth/login"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.environment.get('teacher_password') || pm.environment.get('teacher_password') === 'replace_with_demo_password') { console.warn(\"Teacher login skipped: set teacher_password to the demo teacher password from your local .env.\"); pm.execution.skipRequest(); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Teacher login returns 200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Teacher login returns an access token', () => pm.expect(body.access_token).to.be.a('string').and.not.empty);",
              "if (body.access_token) pm.environment.set('teacher_token', body.access_token);"
            ]
          }
        }
      ]
