    {
      "name": "Create Subject (Teacher)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{teacher_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{subject_name}}\",\n  \"description\": \"IT subject\"\n}"
        },
        "url": "{{base_url}}/subjects"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.environment.get('teacher_token')) { console.warn(\"Create Subject (Teacher) skipped: first run Login Teacher (Demo) with a seeded teacher account.\"); pm.execution.skipRequest(); }",
              "pm.environment.set('subject_name', `Postman Subject ${Date.now()}`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Subject is created (201)', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('Created subject has an ID', () => pm.expect(body.id).to.exist);",
              "if (body.id) pm.environment.set('subject_id', String(body.id));"
            ]
          }
        }
      ]
    },
