            "key": "Authorization",
            "value": "Bearer {{student_token}}"
          }
        ],
        "url": "{{base_url}}/materials?keyword=notes&subjectId={{subject_id}}&categoryId={{category_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Materials request returns 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Materials response is a list', () => pm.expect(pm.response.json()).to.be.an('array'));"
